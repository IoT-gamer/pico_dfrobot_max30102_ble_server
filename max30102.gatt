// Custom Blood Oxygen & Heart Rate Service
PRIMARY_SERVICE, 0000AA10-0000-1000-8000-00805F9B34FB

// Heart Rate Characteristic (32-bit integer, Notify)
CHARACTERISTIC, 0000AA11-0000-1000-8000-00805F9B34FB, READ | NOTIFY | DYNAMIC
CHARACTERISTIC_FORMAT, READ, 08, 00, 2700, 01, 0000

// SPO2 Characteristic (8-bit integer, Notify)
CHARACTERISTIC, 0000AA12-0000-1000-8000-00805F9B34FB, READ | NOTIFY | DYNAMIC
CHARACTERISTIC_FORMAT, READ, 04, 00, 2700, 01, 0000

// Sensor Control Characteristic (8-bit integer, Write)
// Write 0x01 to Start, 0x00 to Stop
CHARACTERISTIC, 0000AA13-0000-1000-8000-00805F9B34FB, WRITE | DYNAMIC